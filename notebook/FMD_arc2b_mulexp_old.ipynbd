    {
      "cell_type": "code",
      "source": [
        "def visualize_correct(X_correct, y_true_correct, y_pred_correct, wavelet, experimento, categorias, num_examples=30):\n",
        "    base_dir = 'saves/metrics'\n",
        "    wavelet_dir = os.path.join(base_dir, f'{wavelet}-experiment')\n",
        "    exp_dir = os.path.join(wavelet_dir, f'experiment_{experimento}')\n",
        "    subdirs = ['confusion_matrix', 'training_history', 'csv_results', 'predict-image']\n",
        "    sub_paths = [os.path.join(exp_dir, sub) for sub in subdirs]\n",
        "    export_metrics.create_directories(wavelet_dir, exp_dir, *sub_paths)\n",
        "\n",
        "    labels_fmd = categorias\n",
        "\n",
        "    if len(X_correct) == 0:\n",
        "        print(f\"No hay aciertos para la wavelet {wavelet}\")\n",
        "        return\n",
        "\n",
        "    # Asegurarse de no pedir más ejemplos de los que hay\n",
        "    num_examples = min(num_examples, len(X_correct))\n",
        "\n",
        "    # Usar una cuadrícula de 2x3 para 6 ejemplos\n",
        "    fig, axes = plt.subplots(3, 3, figsize=(12, 8))\n",
        "    axes = axes.flatten()\n",
        "\n",
        "    for i in range(num_examples):\n",
        "        ax = axes[i]\n",
        "\n",
        "        if len(X_correct[i].shape) == 3 and X_correct[i].shape[-1] > 1:\n",
        "            img = X_correct[i][:, :, 0]\n",
        "        else:\n",
        "            img = X_correct[i].squeeze()\n",
        "\n",
        "        ax.imshow(img, cmap='gray')\n",
        "        ax.axis('off')\n",
        "\n",
        "        true_label = labels_fmd[y_true_correct[i]]\n",
        "        pred_label = labels_fmd[y_pred_correct[i]]\n",
        "\n",
        "        # Cambiar el color a verde para indicar acierto\n",
        "        ax.set_title(f\"Real: {true_label}\\nPredicción: {pred_label}\",\n",
        "                     fontsize=10, color='green')\n",
        "\n",
        "    # Cambiar el título principal\n",
        "    plt.suptitle(f\"Ejemplos de Aciertos - {wavelet}\", fontsize=14, fontweight='bold')\n",
        "    plt.tight_layout()\n",
        "    pred_correct = os.path.join(sub_paths[3], f\"model_FMD-{wavelet}-{experimento}-correct.pdf\")\n",
        "    plt.savefig(pred_correct)\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "print(\"\\n\" + \"=\"*80)\n",
        "print(\"VISUALIZANDO EJEMPLOS DE PREDICCIONES CORRECTAS\")\n",
        "print(\"=\"*80 + \"\\n\")\n",
        "\n",
        "for wavelet in wavelets:\n",
        "    eval_data = evaluation_results[wavelet]\n",
        "\n",
        "    # Obtener todas las etiquetas (como índices de clase)\n",
        "    y_test_classes = eval_data['y_test_classes']\n",
        "    y_pred_classes = eval_data['y_pred_classes']\n",
        "\n",
        "    # Usamos np.where para esto\n",
        "    correct_indices = np.where(y_test_classes == y_pred_classes)[0]\n",
        "\n",
        "    if len(correct_indices) > 0:\n",
        "        print(f\"\\nEjemplos de aciertos para {wavelet}:\")\n",
        "\n",
        "        # Obtener el conjunto de prueba completo para esta wavelet\n",
        "        X_test = X_test_wavelets_L1[wavelet]\n",
        "\n",
        "        # Filtrar los datos usando los índices correctos\n",
        "        X_correct = X_test[correct_indices]\n",
        "        y_true_correct = y_test_classes[correct_indices]\n",
        "        y_pred_correct = y_pred_classes[correct_indices]\n",
        "\n",
        "        # Llamar a la nueva función de visualización\n",
        "        visualize_correct(X_correct, y_true_correct, y_pred_correct, wavelet, experimento, categorias, num_examples=9)\n",
        "    else:\n",
        "        # Esto será común si tu modelo tiene 10% de aciertos\n",
        "        print(f\"No hay aciertos para {wavelet}\")\n",
        "\n",
        "print(\"\\n\" + \"=\"*80 + \"\\n\")\n"
      ],
