        "# =============================================================================\n",
        "# ANÁLISIS ADICIONAL: ESTADÍSTICAS DE ERRORES POR WAVELET\n",
        "# =============================================================================\n",
        "\n",
        "print(\"\\n\" + \"=\"*80)\n",
        "print(\"ANÁLISIS DE ERRORES POR WAVELET\")\n",
        "print(\"=\"*80 + \"\\n\")\n",
        "\n",
        "error_summary = []\n",
        "\n",
        "for wavelet in wavelets:\n",
        "    eval_data = evaluation_results[wavelet]\n",
        "\n",
        "    total_samples = len(eval_data['y_test_classes'])\n",
        "    num_errors = eval_data['num_errors']\n",
        "    accuracy = eval_data['accuracy']\n",
        "\n",
        "    error_summary.append({\n",
        "        'Wavelet': wavelet,\n",
        "        'Total_Muestras': total_samples,\n",
        "        'Predicciones_Correctas': total_samples - num_errors,\n",
        "        'Predicciones_Incorrectas': num_errors,\n",
        "        'Exactitud': f\"{accuracy*100:.2f}%\",\n",
        "        'Error': f\"{(num_errors/total_samples)*100:.2f}%\"\n",
        "    })\n",
        "\n",
        "# Crear DataFrame y mostrar\n",
        "error_df = pd.DataFrame(error_summary)\n",
        "print(error_df.to_string(index=False))\n",
        "\n",
        "print(\"\\n\" + \"=\"*80 + \"\\n\")\n"
      ],
