      "source": [
        "# =============================================================================\n",
        "# VISUALIZACIÓN DE EJEMPLOS DE PREDICCIONES INCORRECTAS\n",
        "# =============================================================================\n",
        "\n",
        "def visualize_errors(X_errors, y_true_errors, y_pred_errors, wavelet, experimento, categorias, num_examples=30):\n",
        "\n",
        "    base_dir = 'saves/metrics'\n",
        "    wavelet_dir = os.path.join(base_dir, f'{wavelet}-experiment')\n",
        "    exp_dir = os.path.join(wavelet_dir, f'experiment_{experimento}')\n",
        "    subdirs = ['confusion_matrix', 'training_history', 'csv_results', 'predict-image']\n",
        "    sub_paths = [os.path.join(exp_dir, sub) for sub in subdirs]\n",
        "    export_metrics.create_directories(wavelet_dir, exp_dir, *sub_paths)\n",
        "\n",
        "    labels_fmd = categorias\n",
        "\n",
        "    if len(X_errors) == 0:\n",
        "        print(f\"No hay errores para la wavelet {wavelet}\")\n",
        "        return\n",
        "\n",
        "    num_examples = min(num_examples, len(X_errors))\n",
        "\n",
        "    fig, axes = plt.subplots(3, 3, figsize=(12, 8))\n",
        "    axes = axes.flatten()\n",
        "\n",
        "    for i in range(num_examples):\n",
        "        ax = axes[i]\n",
        "\n",
        "        # Visualizar primera canal (aproximación) si tiene múltiples canales\n",
        "        if len(X_errors[i].shape) == 3 and X_errors[i].shape[-1] > 1:\n",
        "            img = X_errors[i][:, :, 0]\n",
        "        else:\n",
        "            img = X_errors[i].squeeze()\n",
        "\n",
        "        ax.imshow(img, cmap='gray')\n",
        "        ax.axis('off')\n",
        "\n",
        "        true_label = labels_fmd[y_true_errors[i]]\n",
        "        pred_label = labels_fmd[y_pred_errors[i]]\n",
        "\n",
        "        ax.set_title(f\"Real: {true_label}\\nPredicción: {pred_label}\",\n",
        "                     fontsize=10, color='red')\n",
        "\n",
        "    plt.suptitle(f\"Ejemplos de Errores - {wavelet}\", fontsize=14, fontweight='bold')\n",
        "    plt.tight_layout()\n",
        "    pred_error = os.path.join(sub_paths[3], f\"model_FMD-{wavelet}-{experimento}-errors.pdf\")\n",
        "    plt.savefig(pred_error)\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "\n",
        "# Visualizar errores para cada wavelet\n",
        "print(\"\\n\" + \"=\"*80)\n",
        "print(\"VISUALIZANDO EJEMPLOS DE PREDICCIONES INCORRECTAS\")\n",
        "print(\"=\"*80 + \"\\n\")\n",
        "\n",
        "for wavelet in wavelets:\n",
        "    eval_data = evaluation_results[wavelet]\n",
        "\n",
        "    if eval_data['num_errors'] > 0:\n",
        "        print(f\"\\nEjemplos de errores para {wavelet}:\")\n",
        "\n",
        "        errors = eval_data['errors']\n",
        "        X_test = X_test_wavelets_L1[wavelet]\n",
        "\n",
        "        X_errors = X_test[errors]\n",
        "        y_true_errors = eval_data['y_test_classes'][errors]\n",
        "        y_pred_errors = eval_data['y_pred_classes'][errors]\n",
        "\n",
        "        visualize_errors(X_errors, y_true_errors, y_pred_errors, wavelet, experimento, categorias, num_examples=9)\n",
        "    else:\n",
        "        print(f\"No hay errores para {wavelet}\")\n",
        "\n",
        "print(\"\\n\" + \"=\"*80 + \"\\n\")\n"
      ],
