    {
      "cell_type": "code",
      "source": [
        "all_results = utils_cache.load_data_train_val(experimento)\n",
        "if all_results is None:\n",
        "    raise Exception(f\"No se pudieron cargar los resultados del Exp {experimento}.\")\n",
        "\n",
        "training_histories = all_results['training_histories']\n",
        "training_times = all_results['training_times']\n",
        "evaluation_results = all_results['evaluation_results']"
      ],
      "metadata": {
