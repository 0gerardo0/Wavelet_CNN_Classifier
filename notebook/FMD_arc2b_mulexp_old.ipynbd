        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Resultados de entrenamiento cargados exitosamente.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Diccionarios para almacenar resultados\n",
        "evaluation_results = {}\n",
        "experiment_summary = {}\n",
        "\n",
        "for wavelet in wavelets:\n",
        "    print(f\"\\n{'='*80}\")\n",
        "    print(f\"EVALUANDO MODELO: {wavelet.upper()}\")\n",
        "    print(f\"{'='*80}\\n\")\n",
        "\n",
        "    # Construir ruta del modelo guardado\n",
        "    model_path = f'saves/checkpointer/{wavelet}-experiment/model_save/model_FDM-{wavelet}-{experimento}-(keras).keras'\n",
        "\n",
        "    # Cargar modelo con manejo de errores\n",
        "    try:\n",
        "        model = load_model(model_path)\n",
        "        print(f\"Modelo cargado exitosamente: {model_path}\\n\")\n",
        "    except Exception as e:\n",
        "        print(f\"Error cargando el modelo: {model_path}\")\n",
        "        print(f\"   Error: {e}\\n\")\n",
        "        continue\n",
        "\n",
        "    # model.summary()\n",
        "\n",
        "    # Obtener datos de prueba para esta wavelet\n",
        "    X_test_L1 = X_test_wavelets_L1[wavelet]\n",
        "    X_test_L2 = X_test_wavelets_L2[wavelet]\n",
        "    X_test_L3 = X_test_wavelets_L3[wavelet]\n",
        "    X_test_raw = X_test_orig\n",
        "    #X_test_raw = np.tile(X_test_orig, (4, 1, 1, 1))\n",
        "\n",
        "    y_test = y_test_wavelets_L1[wavelet]\n",
        "\n",
        "    X_test_list = [X_test_raw, X_test_L1, X_test_L2, X_test_L3]\n",
        "\n",
        "    print(f\"Dimensiones de datos de prueba (Shape de la LISTA de inputs):\")\n",
        "    print(f\"   X_test_raw: {X_test_raw.shape}\")\n",
        "    print(f\"   X_test_L1: {X_test_L1.shape}\")\n",
        "    print(f\"   X_test_L2: {X_test_L2.shape}\")\n",
        "    print(f\"   X_test_L3: {X_test_L3.shape}\")\n",
        "    print(f\"   y_test: {y_test.shape}\\n\")\n",
        "\n",
        "    # Evaluar el modelo en el conjunto de prueba\n",
        "    print(f\"Evaluando modelo en datos de prueba...\")\n",
        "    loss, accuracy = model.evaluate(X_test_list, y_test, verbose=0)\n",
        "\n",
        "    print(f\"\\nResultados de Evaluación:\")\n",
        "    print(f\"   Exactitud: {accuracy*100:.2f}%\")\n",
        "    print(f\"   Perdida: {loss:.4f}\\n\")\n",
        "\n",
        "    # Predicciones del conjunto de prueba\n",
        "    print(f\"Generando predicciones...\")\n",
        "    predictions = model.predict(X_test_list, verbose=0)\n",
        "    y_pred_classes = np.argmax(predictions, axis=1)\n",
        "    y_test_classes = np.argmax(y_test, axis=1)\n",
        "\n",
        "    # Calcular errores\n",
        "    errors = (y_pred_classes != y_test_classes)\n",
        "    num_errors = np.sum(errors)\n",
        "    error_rate = (num_errors / len(y_test_classes)) * 100\n",
        "\n",
        "    print(f\"   Total de muestras: {len(y_test_classes)}\")\n",
        "    print(f\"   Predicciones correctas: {len(y_test_classes) - num_errors}\")\n",
        "    print(f\"   Predicciones incorrectas: {num_errors}\")\n",
        "    print(f\"   Tasa de error: {error_rate:.2f}%\\n\")\n",
        "\n",
        "    # Almacenar resultados de evaluación\n",
        "    evaluation_results[wavelet] = {\n",
        "        'model': model,\n",
        "        'loss': loss,\n",
        "        'accuracy': accuracy,\n",
        "        'predictions': predictions,\n",
        "        'y_pred_classes': y_pred_classes,\n",
        "        'y_test_classes': y_test_classes,\n",
        "        'errors': errors,\n",
        "        'num_errors': num_errors\n",
        "    }\n",
        "\n",
        "    # Preparar diccionario de parámetros del experimento\n",
        "    shape_raw = X_train_orig.shape[1:]\n",
        "    shape_L1 = X_train_wavelets_L1[wavelet].shape[1:]\n",
        "    shape_L2 = X_train_wavelets_L2[wavelet].shape[1:]\n",
        "    shape_L3 = X_train_wavelets_L3[wavelet].shape[1:]\n",
        "\n",
        "    num_train_samples = X_train_wavelets_L1[wavelet].shape[0]\n",
        "    num_test_samples = X_test_wavelets_L1[wavelet].shape[0]\n",
        "    num_validation_samples = int(0.2 * num_train_samples)\n",
        "\n",
        "    params_dict = {\n",
        "        \"dataset\": \"FMD\",\n",
        "        \"wavelet\": wavelet,\n",
        "        \"experimento\": experimento,\n",
        "        \"image_size_original\": image_size,\n",
        "        # Guardamos todos los shapes\n",
        "        \"shape_raw\": shape_raw,\n",
        "        \"shape_L1_DWT\": shape_L1,\n",
        "        \"shape_L2_DWT\": shape_L2,\n",
        "        \"shape_L3_DWT\": shape_L3,\n",
        "        \"n_imagenes_por_clase\": n_imagenes,\n",
        "        \"nivel_descomposicion\": \"Fusión 1-2-3\", # Actualizado\n",
        "        \"num_train_samples_tiled\": num_train_samples,\n",
        "        \"num_test_samples_tiled\": num_test_samples,\n",
        "        \"num_validation_samples\": num_validation_samples,\n",
        "        \"learning_rate\": INIT_LR,\n",
        "        \"epochs\": epochs,\n",
        "        \"batch_size\": batch_size,\n",
        "        \"num_classes\": n_class,\n",
        "        \"dropout\": dropout,\n",
        "        \"loss_function\": loss_funtion,\n",
        "        \"optimizer\": \"Adam\",\n",
        "        \"SEED\": SEED\n",
        "    }\n",
        "\n",
        "    # Guardar parámetros del experimento\n",
        "    print(f\"Guardando parámetros del experimento...\")\n",
        "    export_metrics.save_parameters(params_dict, wavelet, experimento, dataset_type='FMD')\n",
        "\n",
        "    # Generar reporte completo (métricas, gráficas, CSVs)\n",
        "    print(f\"\\nGenerando reporte completo...\\n\")\n",
        "    export_metrics.generate_complete_report(\n",
        "        loss=loss,\n",
        "        accuracy=accuracy,\n",
        "        y_true=y_test_classes,\n",
        "        y_pred=y_pred_classes,\n",
        "        history=training_histories[wavelet],\n",
        "        wavelet=wavelet,\n",
        "        experiment=experimento,\n",
        "        custom_labels=categorias,\n",
        "        dataset_type='FMD',\n",
        "        show_inline=True,   # Mostrar gráficas en notebook\n",
        "        save_pdf=True       # Guardar PDFs\n",
        "    )\n",
        "\n",
        "    # Calcular métricas adicionales para el resumen\n",
        "    precision = export_metrics.calculate_precision(y_test_classes, y_pred_classes)\n",
        "    recall = export_metrics.calculate_recall(y_test_classes, y_pred_classes)\n",
        "    f1 = export_metrics.calculate_f1_score(y_test_classes, y_pred_classes)\n",
        "\n",
        "    # Almacenar para resumen consolidado\n",
        "    experiment_summary[wavelet] = {\n",
        "        'Loss': loss,\n",
        "        'Accuracy': accuracy,\n",
        "        'Precision': precision,\n",
        "        'Recall': recall,\n",
        "        'F1_Score': f1,\n",
        "        'Num_Errors': num_errors,\n",
        "        'Error_Rate': error_rate\n",
        "    }\n",
        "\n",
        "    print(f\"\\n{'='*80}\")\n",
        "    print(f\"EVALUACIÓN COMPLETADA PARA: {wavelet.upper()}\")\n",
        "    print(f\"{'='*80}\\n\")\n",
        "\n",
        "print(\"\\n\" + \"=\"*80)\n",
        "print(\"TODAS LAS EVALUACIONES INDIVIDUALES COMPLETADAS\")\n",
        "print(\"=\"*80 + \"\\n\")\n"
      ],
