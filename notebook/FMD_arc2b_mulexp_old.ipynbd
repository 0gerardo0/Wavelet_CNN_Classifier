        "\n",
        "print(\"--- MAPA DE ETIQUETAS (NÚMERO -> NOMBRE) ---\")\n",
        "label_map = {i: nombre for i, nombre in enumerate(categorias)}\n",
        "print(label_map)\n",
        "print(\"-------------------------------------------------\")\n",
        "\n",
        "\n",
        "# Convertir a categórico\n",
        "labels_categorical = to_categorical(y_train_orig, num_classes=n_class)\n",
        "\n",
        "\n",
        "# Verificación Visual Aleatoria\n",
        "print(\"\\nIniciando verificación visual aleatoria...\")\n",
        "\n",
        "# Tomar 5 muestras aleatorias\n",
        "for _ in range(5):\n",
        "    # Elegir un índice aleatorio del dataset\n",
        "    idx = random.randint(0, len(X_train_orig) - 1)\n",
        "\n",
        "    imagen_muestra = X_train_orig[idx]\n",
        "    label_crudo = y_train_orig[idx]\n",
        "    label_one_hot = labels_categorical[idx]\n",
        "\n",
        "    # Revertir el 'one-hot' para confirmar\n",
        "    label_revertido_idx = np.argmax(label_one_hot)\n",
        "\n",
        "    # Obtener el nombre de la etiqueta usando el mapa\n",
        "    nombre_etiqueta = label_map[label_revertido_idx]\n",
        "\n",
        "    print(f\"\\n--- Verificando Muestra Aleatoria (Índice: {idx}) ---\")\n",
        "    print(f\"Etiqueta 'cruda' (número): {label_crudo}\")\n",
        "    print(f\"Etiqueta 'one-hot': {label_one_hot}\")\n",
        "    print(f\"Nombre de Etiqueta : '{nombre_etiqueta}'\")\n",
        "\n",
        "    # Mostrar la imagen\n",
        "    plt.imshow(imagen_muestra.squeeze(), cmap='gray')\n",
        "    plt.title(f\"Índice: {idx}\\nTu código dice que esto es: '{nombre_etiqueta}' (Clase {label_crudo})\")\n",
        "    plt.show()"
      ],
