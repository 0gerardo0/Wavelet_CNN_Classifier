    {
      "cell_type": "code",
      "source": [
        "def process_dwt(image_set, wavelet, level):\n",
        "  dataDWT_cA, dataDWT_cH, dataDWT_cV, dataDWT_cD = ([] for _ in range(4))\n",
        "\n",
        "  for imagen_array in image_set:\n",
        "    if len(imagen_array.shape) == 3:\n",
        "        imagen_array = imagen_array[:, :, 0] # Asegurar 2D para DWT\n",
        "\n",
        "    # Aplicar DWT\n",
        "    coeffs = pywt.wavedec2(imagen_array, wavelet, level=level)\n",
        "\n",
        "    cA_target = None\n",
        "    cH_target = None\n",
        "    cV_target = None\n",
        "    cD_target = None\n",
        "\n",
        "    if level == 3:\n",
        "      # Desempaquetar para 3 niveles\n",
        "      (cA, (cH, cV, cD), (cH2, cV2, cD2), (cH1, cV1, cD1)) = coeffs\n",
        "\n",
        "      cA_target = cA\n",
        "      cH_target = cH\n",
        "      cV_target = cV\n",
        "      cD_target = cD\n",
        "\n",
        "    elif level == 2:\n",
        "      # Desempaquetar para 2 niveles\n",
        "      (cA, (cH, cV, cD), (cH1, cV1, cD1)) = coeffs\n",
        "\n",
        "      cA_target = cA\n",
        "      cH_target = cH\n",
        "      cV_target = cV\n",
        "      cD_target = cD\n",
        "\n",
        "    elif level == 1:\n",
        "      # Desempaquetar para 1 nivel\n",
        "      (cA, (cH, cV, cD)) = coeffs\n",
        "\n",
        "      cA_target = cA\n",
        "      cH_target = cH\n",
        "      cV_target = cV\n",
        "      cD_target = cD\n",
        "    else:\n",
        "      print(f\"Error: Nivel {level} no soportado. Debe ser 1, 2 o 3.\")\n",
        "\n",
        "      continue\n",
        "\n",
        "    # Guardar los coeficientes del nivel seleccionado\n",
        "    dataDWT_cA.append(cA_target)\n",
        "    dataDWT_cH.append(cH_target)\n",
        "    dataDWT_cV.append(cV_target)\n",
        "    dataDWT_cD.append(cD_target)\n",
        "\n",
        "  # Convertir listas a arrays de NumPy\n",
        "  #dataDWT_cA, dataDWT_cH, dataDWT_cV, dataDWT_cD = map(np.array, (dataDWT_cA, dataDWT_cH, dataDWT_cV, dataDWT_cD))\n",
        "  #dataDWT_processed = np.stack((dataDWT_cA, dataDWT_cH, dataDWT_cV, dataDWT_cD), axis=-1)\n",
        "  dataDWT_processed = np.array(dataDWT_cA)\n",
        "\n",
        "\n",
        "  return dataDWT_processed"
      ],
      "metadata": {
        "id": "7pTrWdHtYIdt"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def dicc_prepro(X_train_dwt, X_test_dwt, y_train_orig, y_test_orig, n_class):\n",
        "  # Preparación de Etiquetas\n",
        "  #y_train_labels_tiled = np.tile(y_train_orig, 4)\n",
        "  #y_test_labels_tiled = np.tile(y_test_orig, 4)\n",
        "\n",
        "  # Convertir a categórico (One-Hot)\n",
        "  y_train_categorical = to_categorical(y_train_orig, num_classes=n_class)\n",
        "  y_test_categorical = to_categorical(y_test_orig, num_classes=n_class)\n",
        "\n",
        "  # Preparación de Datos\n",
        "\n",
        "  # Guardar los shapes originales para usarlos después\n",
        "  train_shape = X_train_dwt.shape\n",
        "  test_shape = X_test_dwt.shape\n",
        "\n",
        "  # Aplanar los datos a 2D (NxM, 1) para el scaler\n",
        "  X_train_flat = X_train_dwt.reshape(train_shape[0], -1)\n",
        "  X_test_flat = X_test_dwt.reshape(test_shape[0], -1)\n",
        "  #X_train_flat = X_train_dwt.reshape(-1, 1)\n",
        "  #X_test_flat = X_test_dwt.reshape(-1, 1)\n",
        "\n",
        "  # Inicializar y ajustar el scaler SOLO con datos de entrenamiento\n",
        "  scaler = MinMaxScaler()\n",
        "  scaler.fit(X_train_flat)\n",
        "\n",
        "  # Transformar ambos sets\n",
        "  X_train_scaled_flat = scaler.transform(X_train_flat)\n",
        "  X_test_scaled_flat = scaler.transform(X_test_flat)\n",
        "\n",
        "  # Regresar los datos a su shape original (N*4, H, W)\n",
        "  X_train_normalized = X_train_scaled_flat.reshape(train_shape)\n",
        "  X_test_normalized = X_test_scaled_flat.reshape(test_shape)\n",
        "\n",
        "  # Añadir la dimensión del canal\n",
        "  X_train_normalized = np.expand_dims(X_train_normalized, axis=-1)\n",
        "  X_test_normalized = np.expand_dims(X_test_normalized, axis=-1)\n",
        "\n",
        "  return X_train_normalized, X_test_normalized, y_train_categorical, y_test_categorical, scaler"
      ],
      "metadata": {
        "id": "70tbWjcMYaLE"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Diccionarios Nivel 1\n",
        "X_train_wavelets_L1, X_test_wavelets_L1 = {}, {}\n",
        "y_train_wavelets_L1, y_test_wavelets_L1 = {}, {}\n",
        "scalers_L1 = {}\n",
        "\n",
        "# Diccionarios Nivel 2\n",
        "X_train_wavelets_L2, X_test_wavelets_L2 = {}, {}\n",
        "y_train_wavelets_L2, y_test_wavelets_L2 = {}, {}\n",
        "scalers_L2 = {}\n",
        "\n",
        "# Diccionarios Nivel 3\n",
        "X_train_wavelets_L3, X_test_wavelets_L3 = {}, {}\n",
        "y_train_wavelets_L3, y_test_wavelets_L3 = {}, {}\n",
        "scalers_L3 = {}\n",
        "\n",
        "elapsed_times_wavelet = {}\n",
        "\n",
        "print(\"INICIANDO PROCESAMIENTO\")\n",
        "\n",
        "for level in niveles:\n",
        "  print(f\"      Procesando Nivel {level}\")\n",
        "\n",
        "  for wavelet in wavelets:\n",
        "    print(f\"  Procesando wavelet: {wavelet}\")\n",
        "    start_time_wavelet = time.time()\n",
        "\n",
        "    # 1. Obtener Coeficientes DWT\n",
        "    X_train_dwt_raw = process_dwt(X_train_orig, wavelet, level)\n",
        "    X_test_dwt_raw = process_dwt(X_test_orig, wavelet, level)\n",
        "\n",
        "    end_time_wavelet = time.time()\n",
        "    elapsed_times_wavelet[f\"{wavelet}_L{level}\"] = end_time_wavelet - start_time_wavelet\n",
        "    print(f\"    Tiempo DWT: {elapsed_times_wavelet[f'{wavelet}_L{level}']:.2f}s\")\n",
        "\n",
        "    # 2. Aplicar Normalización\n",
        "    (X_train_norm, X_test_norm, y_train_cat, y_test_cat, scaler) = dicc_prepro(X_train_dwt_raw, X_test_dwt_raw, y_train_orig, y_test_orig, n_class)\n",
        "\n",
        "    # 3. Almacenamiento\n",
        "    if level == 1:\n",
        "        X_train_wavelets_L1[wavelet] = X_train_norm\n",
        "        X_test_wavelets_L1[wavelet] = X_test_norm\n",
        "        y_train_wavelets_L1[wavelet] = y_train_cat\n",
        "        y_test_wavelets_L1[wavelet] = y_test_cat\n",
        "        scalers_L1[wavelet] = scaler\n",
        "\n",
        "    elif level == 2:\n",
        "        X_train_wavelets_L2[wavelet] = X_train_norm\n",
        "        X_test_wavelets_L2[wavelet] = X_test_norm\n",
        "        y_train_wavelets_L2[wavelet] = y_train_cat\n",
        "        y_test_wavelets_L2[wavelet] = y_test_cat\n",
        "        scalers_L2[wavelet] = scaler\n",
        "\n",
        "    elif level == 3:\n",
        "        X_train_wavelets_L3[wavelet] = X_train_norm\n",
        "        X_test_wavelets_L3[wavelet] = X_test_norm\n",
        "        y_train_wavelets_L3[wavelet] = y_train_cat\n",
        "        y_test_wavelets_L3[wavelet] = y_test_cat\n",
        "        scalers_L3[wavelet] = scaler\n",
        "\n",
        "    print(f\"    Shape X_train L{level} {wavelet}: {X_train_norm.shape}\")\n",
        "    print(f\"    Shape y_train L{level} {wavelet}: {y_train_cat.shape}\")\n",
        "    print(f\"    Shape X_test L{level} {wavelet}: {X_test_norm.shape}\")\n",
        "    print(f\"    Shape y_test L{level} {wavelet}: {y_test_cat.shape}\")\n",
        "\n",
        "print(\"\\nProcesamiento de Normalización Completado\")\n"
      ],
