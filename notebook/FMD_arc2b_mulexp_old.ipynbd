    {
      "cell_type": "code",
      "source": [
        "# @title\n",
        "def modelo_basico_cero(input_shape, num_classes):\n",
        "    \"\"\"Un modelo mínimo para probar si se puede aprender algo.\"\"\"\n",
        "    model = Sequential(name=\"Modelo_Basico_Cero\")\n",
        "    model.add(Input(shape=input_shape))\n",
        "\n",
        "    # Bloque 1\n",
        "    model.add(Conv2D(32, (3, 3), activation='relu', padding='same'))\n",
        "    model.add(MaxPooling2D(pool_size=(2, 2)))\n",
        "\n",
        "    # Bloque 2\n",
        "    model.add(Conv2D(64, (3, 3), activation='relu', padding='same'))\n",
        "    model.add(MaxPooling2D(pool_size=(2, 2)))\n",
        "\n",
        "    # Clasificador\n",
        "    model.add(Flatten())\n",
        "    model.add(Dense(64, activation='relu'))\n",
        "    model.add(Dropout(0.5)) # Dropout es importante\n",
        "    model.add(Dense(num_classes, activation='softmax'))\n",
        "\n",
        "\n",
        "    adam_optimizer = Adam(learning_rate=INIT_LR)\n",
        "    model.compile(optimizer=adam_optimizer,\n",
        "                  loss=loss_funtion,\n",
        "                  metrics=[metric_acc])\n",
        "\n",
        "    return model"
      ],
      "metadata": {
        "id": "TtQvLEOg2RTs"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# @title\n",
        "# Diccionario para guardar las historias de entrenamiento y tiempos\n",
        "training_histories = {}\n",
        "training_times = {}\n",
        "# Diccionario para almacenar los resultados de evaluación\n",
        "evaluation_results = {}\n",
        "\n",
        "for wavelet in wavelets:\n",
        "    print(f'Entrenando con la wavelet: {wavelet}')\n",
        "\n",
        "    # Limpiar la sesión previa para liberar memoria\n",
        "    K.clear_session()\n",
        "\n",
        "    # Obtener los datos para la wavelet actual\n",
        "    X_train = X_train_wavelets[wavelet]\n",
        "    X_test = X_test_wavelets[wavelet]\n",
        "    y_train = y_train_wavelets[wavelet]\n",
        "    y_test = y_test_wavelets[wavelet]\n",
        "\n",
        "    # Crear el modelo\n",
        "    input_shape = X_train.shape[1:]\n",
        "    model = modelo_basico_cero(input_shape, n_class)\n",
        "\n",
        "    # Mostrar el resumen del modelo\n",
        "    model.summary()\n",
        "\n",
        "    # Definir callbacks\n",
        "    checkpoints = get_checkpoints(wavelet, experimento)\n",
        "    early = EarlyStopping(monitor='val_accuracy', min_delta=0, patience=15, verbose=1, mode='max', restore_best_weights=True)\n",
        "    csv_logger = get_csv_logger(wavelet, experimento)\n",
        "    reduce_lr = ReduceLROnPlateau(monitor='val_loss', factor=0.1, patience=2, min_lr=1e-6)\n",
        "\n",
        "    start_time = time.time()\n",
        "    # Entrenar el modelo\n",
        "    history = model.fit(X_train, y_train, batch_size=batch_size, epochs=epochs, validation_split=0.2, shuffle=True, callbacks=[csv_logger, reduce_lr, checkpoints, early])\n",
        "    end_time = time.time()\n",
        "    elapsed_time = end_time - start_time\n",
        "    training_times[wavelet] = elapsed_time\n",
        "\n",
        "\n",
        "    print(f'Tiempo de entrenamiento para {wavelet}: {elapsed_time:.2f} segundos')\n",
        "\n",
        "    # Guardar las métricas de entrenamiento\n",
        "    training_histories[wavelet] = history.history\n",
        "\n",
        "        # Guardar el modelo entrenado\n",
        "    export_model(wavelet, experimento, model)"
      ],
      "metadata": {
        "id": "hQoxOtmzvKHI",
        "cellView": "form"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def cnn_funtional_mod(shape_raw, shape_L1, shape_L2, shape_L3, num_classes):\n",
        "\n",
        "  # 1. Definir Entradas\n",
        "  inputA = Input(shape=shape_raw, name=\"Input_Raw\")\n",
        "  inputB = Input(shape=shape_L1, name=\"Input_L1_DWT\")\n",
        "  inputC = Input(shape=shape_L2, name=\"Input_L2_DWT\")\n",
        "  inputD = Input(shape=shape_L3, name=\"Input_L3_DWT\")\n",
        "\n",
        "  l1 = MaxPooling2D(pool_size=(2, 2), strides=(2,2), name='block1_Pool')(inputA)\n",
        "\n",
        "  # Rama 1 (Input A - Crudo)\n",
        "  conv1 = Conv2D(64, (3, 3), strides=1, padding='same', activation='relu', name='block1_conv1')(inputA)\n",
        "  conv2 = Conv2D(64, (3, 3), strides=2, padding='same', activation='relu', name='block1_conv2')(conv1)\n",
        "\n",
        "  target_H_L1 = conv2.shape[1]\n",
        "  target_W_L1 = conv2.shape[2]\n",
        "\n",
        "  # Rama 2 (Input B - Nivel 1)\n",
        "  conv1_1 = Conv2D(64, (3, 3), strides=1, padding='same', activation='relu', name='block1_conv3')(inputB)\n",
        "\n",
        "  # Redimensionar\n",
        "  conv1_1_resized = Resizing(target_H_L1, target_W_L1, name='Resize_L1')(conv1_1)\n",
        "\n",
        "  # Fusión 1\n",
        "  concat1 = concatenate([conv2, conv1_1_resized, l1], name='channel-wise_concat')\n",
        "  conv3 = Conv2D(128, (3, 3), strides=1, padding='same', activation='relu', name='block2_conv1')(concat1)\n",
        "  conv4 = Conv2D(128, (3, 3), strides=2, padding='same', activation='relu', name='block2_conv2')(conv3)\n",
        "\n",
        "  target_H_L2 = conv4.shape[1]\n",
        "  target_W_L2 = conv4.shape[2]\n",
        "\n",
        "  # Rama 3 (Input C - Nivel 2)\n",
        "  conv2_1 = Conv2D(64, (3, 3), strides=1, padding='same', activation='relu', name='block2_conv3')(inputC)\n",
        "  conv3_1 = Conv2D(128, (3, 3), strides=1, padding='same', activation='relu', name='block2_conv4')(conv2_1)\n",
        "\n",
        "  # Redimensionar\n",
        "  conv3_1_resized = Resizing(target_H_L2, target_W_L2, name='Resize_L2')(conv3_1)\n",
        "\n",
        "  l2 = MaxPooling2D(pool_size=(2, 2), strides=(2,2), name='block2_Pool')(concat1)\n",
        "\n",
        "  # Fusión 2\n",
        "  concat2 = concatenate([conv4, conv3_1_resized, l2], name='channel-wise_concat1')\n",
        "\n",
        "\n",
        "  # Rama 1\n",
        "  conv6 = Conv2D(256, (3, 3), strides=1, padding='same', activation='relu', name='block3_conv1')(concat2)\n",
        "  conv7 = Conv2D(256, (3, 3), strides=2, padding='same', activation='relu', name='block3_conv2')(conv6)\n",
        "\n",
        "  target_H_L3 = conv7.shape[1]\n",
        "  target_W_L3 = conv7.shape[2]\n",
        "\n",
        "  # Rama 2 (Input D - Nivel 3)\n",
        "  conv_L3_1 = Conv2D(128, (3, 3), strides=1, padding='same', activation='relu', name='block3_conv_L3_1')(inputD)\n",
        "  conv_L3_2 = Conv2D(256, (3, 3), strides=1, padding='same', activation='relu', name='block3_conv_L3_2')(conv_L3_1)\n",
        "\n",
        "\n",
        "  # Redimensionar\n",
        "  conv_L3_2_resized = Resizing(target_H_L3, target_W_L3, name='Resize_L3')(conv_L3_2)\n",
        "\n",
        "  l3 = MaxPooling2D(pool_size=(2, 2), strides=(2,2), padding='same', name='block3_Pool')(concat2)\n",
        "\n",
        "  # Fusión 3\n",
        "  concat3 = concatenate([conv7, conv_L3_2_resized, l3], name='channel-wise_concat2')\n",
        "\n",
        "\n",
        "  conv8 = Conv2D(512, (3, 3), strides=1, padding='same', activation='relu', name='block4_conv1')(concat3)\n",
        "  conv9 = Conv2D(512, (3, 3), strides=2, padding='same', activation='relu', name='block4_conv2')(conv8)\n",
        "\n",
        "  # Cabezal de Clasificación\n",
        "  avep1 = GlobalAveragePooling2D(name='block4_globalAPool')(conv9)\n",
        "  modelx_dr = Dropout(dropout, name='modelx_drop')(avep1)\n",
        "  output = Dense(num_classes, activation='softmax', name='predictions')(modelx_dr)\n",
        "\n",
        "  model = Model(inputs=[inputA, inputB, inputC, inputD], outputs=output)\n",
        "\n",
        "  adam_optimizer = Adam(learning_rate=INIT_LR, beta_1=0.9, beta_2=0.999, epsilon=1e-08)\n",
        "  model.compile(optimizer=adam_optimizer,\n",
        "                loss=loss_funtion,\n",
        "                metrics=[metric_acc])\n",
        "\n",
        "  return model"
      ],
      "metadata": {
        "id": "RrReHv-XuE9x"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Diccionario para guardar las historias de entrenamiento y tiempos\n",
        "training_histories = {}\n",
        "training_times = {}\n",
        "# Diccionario para almacenar los resultados de evaluación\n",
        "evaluation_results = {}\n",
        "model_parameters = {} # Para la documentación\n",
        "\n",
        "for wavelet in wavelets:\n",
        "  print(f'Entrenando con la wavelet: {wavelet}\\n')\n",
        "\n",
        "  # Limpiar la sesión previa para liberar memoria\n",
        "  K.clear_session()\n",
        "\n",
        "  # Datos de entrenamiento de entrada\n",
        "  X_train_raw = X_train_orig\n",
        "  #X_train_raw = np.tile(X_train_orig, (4, 1, 1, 1))\n",
        "  X_train_L1 = X_train_wavelets_L1[wavelet]\n",
        "  X_train_L2 = X_train_wavelets_L2[wavelet]\n",
        "  X_train_L3 = X_train_wavelets_L3[wavelet]\n",
        "\n",
        "  # Datos de test\n",
        "  X_test_raw = X_test_orig\n",
        "  #X_test_raw = np.tile(X_test_orig, (4, 1, 1, 1))\n",
        "  X_test_L1 = X_test_wavelets_L1[wavelet]\n",
        "  X_test_L2 = X_test_wavelets_L2[wavelet]\n",
        "  X_test_L3 = X_test_wavelets_L3[wavelet]\n",
        "\n",
        "  # Obtener las ETIQUETAS\n",
        "  y_train = y_train_wavelets_L1[wavelet]\n",
        "  y_test = y_test_wavelets_L1[wavelet]\n",
        "\n",
        "  # Obtener los SHAPES dinámicos -\n",
        "  shape_raw = X_train_raw.shape[1:]\n",
        "  shape_L1 = X_train_L1.shape[1:]\n",
        "  shape_L2 = X_train_L2.shape[1:]\n",
        "  shape_L3 = X_train_L3.shape[1:]\n",
        "\n",
        "  # guardar para documentación\n",
        "  model_parameters[wavelet] = {'shape_raw': shape_raw, 'shape_L1': shape_L1, 'shape_L2': shape_L2, 'shape_L3': shape_L3}\n",
        "\n",
        "  # Crear el Modelo\n",
        "\n",
        "  model = cnn_funtional_mod(shape_raw, shape_L1, shape_L2, shape_L3, n_class)\n",
        "\n",
        "  # Mostrar el resumen del modelo\n",
        "  model.summary()\n",
        "\n",
        "  # Definir Callbacks\n",
        "  checkpoints = get_checkpoints(wavelet, experimento)\n",
        "  early = EarlyStopping(monitor='val_accuracy', min_delta=0, patience=10, verbose=1, mode='max', restore_best_weights=True)\n",
        "  csv_logger = get_csv_logger(wavelet, experimento)\n",
        "  reduce_lr = ReduceLROnPlateau(monitor='val_loss', factor=0.1, patience=10, min_lr=1e-6)\n",
        "\n",
        "  start_time = time.time()\n",
        "\n",
        "  # Entrenar el Modelo\n",
        "  history = model.fit(\n",
        "      [X_train_raw, X_train_L1, X_train_L2, X_train_L3],\n",
        "      y_train,\n",
        "      batch_size=batch_size,\n",
        "      epochs=epochs,\n",
        "      validation_split=0.2,\n",
        "      shuffle=True,\n",
        "      callbacks=[csv_logger, reduce_lr, checkpoints, early]\n",
        "  )\n",
        "\n",
        "  end_time = time.time()\n",
        "  elapsed_time = end_time - start_time\n",
        "  training_times[wavelet] = elapsed_time\n",
        "\n",
        "  print(f'\\nTiempo de entrenamiento para {wavelet}: {elapsed_time:.2f} segundos')\n",
        "\n",
        "  # Guardar las métricas de entrenamiento\n",
        "  training_histories[wavelet] = history.history\n",
        "\n",
        "  # Guardar el modelo entrenado\n",
        "  export_model(wavelet, experimento, model)\n",
        "\n",
        "  # --- 8. Evaluar el Modelo ---\n",
        "  print(f\"\\nEvaluando modelo final para {wavelet}...\")\n",
        "  results = model.evaluate(\n",
        "      [X_test_raw, X_test_L1, X_test_L2, X_test_L3],\n",
        "      y_test\n",
        "  )\n",
        "  evaluation_results[wavelet] = dict(zip(model.metrics_names, results))\n",
        "  print(f\"Resultados {wavelet}: {evaluation_results[wavelet]}\")\n",
        "\n",
        "results_to_cache = {\n",
        "    'training_histories': training_histories,\n",
        "    'training_times': training_times,\n",
        "    'evaluation_results': evaluation_results,\n",
        "    'experimento': experimento,\n",
        "    'model_parameters': model_parameters\n",
        "}\n",
        "\n",
        "utils_cache.save_data_train_val(results_to_cache, experimento)"
      ],
